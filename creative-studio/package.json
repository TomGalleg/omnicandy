{
  "name": "creative-studio",
  "productName": "OmniCandy",
  "version": "0.1.4",
  "private": true,
  "description": "OmniCandy: Windows-first creative desktop app with Claude as Creative Partner for ArtCraft apps",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/build-planner-mcp.mjs",
    "build:planner-mcp": "node scripts/build-planner-mcp.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "catalog": "node scripts/build-catalog.mjs",
    "release:check": "node scripts/release-check.mjs resources",
    "dist:linux": "electron-vite build && node scripts/build-planner-mcp.mjs && node scripts/pack-source.mjs && electron-builder --linux",
    "dist:dir": "electron-vite build && node scripts/build-planner-mcp.mjs && node scripts/pack-source.mjs && electron-builder --dir",
    "dist": "electron-vite build && node scripts/build-planner-mcp.mjs && node scripts/pack-source.mjs && node scripts/release-check.mjs resources && electron-builder",
    "smoke:installed": "node scripts/smoke-installed.mjs",
    "smoke:connect-hybrid": "electron-vite build && node scripts/smoke-connect-hybrid.mjs",
    "catalog:check": "node scripts/catalog-check.mjs",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "smoke:live": "electron-vite build && node scripts/smoke-live.mjs",
    "smoke:generate": "electron-vite build && node scripts/smoke-generate.mjs",
    "smoke:apps": "electron-vite build && node scripts/smoke-apps.mjs",
    "smoke:claude-apps": "electron-vite build && node scripts/smoke-claude-apps.mjs",
    "smoke:audio-deliver": "electron-vite build && node scripts/smoke-audio-deliver.mjs",
    "smoke:multiclip": "electron-vite build && node scripts/smoke-multiclip.mjs",
    "smoke:workflow": "electron-vite build && node scripts/smoke-workflow.mjs",
    "smoke:docks": "electron-vite build && node scripts/smoke-docks.mjs",
    "smoke:docs": "electron-vite build && node scripts/smoke-docs.mjs",
    "smoke:reopen": "electron-vite build && node scripts/smoke-reopen.mjs",
    "smoke:project-planner": "electron-vite build && node scripts/smoke-project-planner.mjs",
    "smoke:planner": "electron-vite build && node scripts/build-planner-mcp.mjs && node scripts/smoke-planner.mjs",
    "smoke:external": "electron-vite build && node scripts/smoke-external.mjs",
    "smoke:claude-external": "electron-vite build && node scripts/smoke-claude-external.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "playwright": "^1.64.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
